rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read, write: if isValidId(clientId);
    }

    // Documents Collection
    match /documents/{documentId} {
      allow read, write: if isValidId(documentId);
    }

    // Custom Folders Collection
    match /custom_folders/{folderId} {
      allow read, write: if isValidId(folderId);
    }

    // Access Requests Collection
    match /access_requests/{requestId} {
      allow read, write: if isValidId(requestId);
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // General match for any subcollections/probes
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
